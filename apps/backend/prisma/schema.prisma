generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  name          String
  avatarUrl     String?
  role          String    @default("USER")
  plan          String    @default("FREE")
  googleId      String?   @unique
  githubId      String?   @unique
  refreshToken  String?
  resetToken    String?
  resetTokenExp DateTime?
  emailVerified Boolean   @default(false)
  theme         String    @default("system")
  emailNotifications Boolean @default(true)
  searchNotifications Boolean @default(true)
  defaultRadius Int       @default(5000)
  defaultCountry String   @default("Portugal")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  searches      Search[]
  favorites     Favorite[]
  exports       DataExport[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
  @@index([plan])
  @@map("users")
}

model Search {
  id           String       @id @default(uuid())
  userId       String
  query        String
  location     String
  category     String
  city         String?
  state        String?
  country      String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  radius       Int          @default(5000)
  status       String       @default("PENDING")
  totalFound   Int          @default(0)
  totalEnriched Int         @default(0)
  progress     Float        @default(0)
  estimatedTime Int?
  error        String?
  sources      String       @default("[]")
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies    Company[]
  jobs         SearchJob[]
  logs         SearchLog[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([city, state, country])
  @@map("searches")
}

model SearchJob {
  id         String   @id @default(uuid())
  searchId   String
  source     String
  status     String   @default("pending")
  progress   Float    @default(0)
  error      String?
  metadata   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  search     Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId])
  @@map("search_jobs")
}

model SearchLog {
  id        String   @id @default(uuid())
  searchId  String
  level     String   @default("info")
  message   String
  source    String?
  createdAt DateTime @default(now())

  search    Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId])
  @@map("search_logs")
}

model Company {
  id              String   @id @default(uuid())
  name            String
  category        String
  description     String?
  phone           String?
  whatsapp        String?
  email           String?
  website         String?
  instagram       String?
  facebook        String?
  linkedin        String?
  tiktok          String?
  youtube         String?
  address         String?
  street          String?
  number          String?
  neighborhood    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  latitude        Float?
  longitude       Float?
  googleMapsLink  String?
  openingHours    String?
  rating          Float?
  totalRatings    Int?
  photos          String   @default("[]")
  isOpen          Boolean?
  hasWebsite      Boolean   @default(false)
  hasInstagram    Boolean   @default(false)
  hasFacebook     Boolean   @default(false)
  hasWhatsapp     Boolean   @default(false)
  hasEmail        Boolean   @default(false)
  source          String
  sourceId        String?
  sourceUrl       String?
  rawData         String?

  searchId        String
  enrichedData    EnrichedData?
  favorites       Favorite[]
  auditLogs       AuditLog[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  search          Search    @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([name])
  @@index([category])
  @@index([city, state, country])
  @@index([rating])
  @@index([hasWebsite, hasInstagram, hasWhatsapp, hasEmail])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@map("companies")
}

model EnrichedData {
  id                String        @id @default(uuid())
  companyId         String        @unique
  qualityScore      Int?
  presenceLevel     String?
  hasVisualIdentity Boolean       @default(false)
  hasModernWebsite  Boolean       @default(false)
  instagramActive   Boolean       @default(false)
  postsFrequently   Boolean       @default(false)
  hasFewRatings     Boolean       @default(true)
  needsMarketing    Boolean       @default(true)
  needsAutomation   Boolean       @default(true)
  needsChatbot      Boolean       @default(true)
  needsNewWebsite   Boolean       @default(true)
  needsPaidTraffic  Boolean       @default(true)
  analysisText      String?
  enrichedAt        DateTime      @default(now())

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([qualityScore])
  @@index([presenceLevel])
  @@map("enriched_data")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  notes     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("favorites")
}

model DataExport {
  id        String       @id @default(uuid())
  userId    String
  searchId  String?
  format    String
  fileName  String
  fileSize  Int?
  fileUrl   String?
  filters   String?
  status    String       @default("processing")
  createdAt DateTime     @default(now())
  completedAt DateTime?

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_exports")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  companyId String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model RateLimit {
  id        String   @id @default(uuid())
  userId    String?
  ip        String?
  endpoint  String
  hits      Int      @default(1)
  windowStart DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, endpoint])
  @@index([ip, endpoint])
  @@map("rate_limits")
}

model CacheEntry {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  ttl       Int?
  createdAt DateTime @default(now())

  @@index([key])
  @@index([createdAt])
  @@map("cache_entries")
}
